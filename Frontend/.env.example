VITE_ prefix is required — only these reach the browser bundle.
Keep the Gemini key and MONGO_URI in Backend/.env, never here.

# Base URL of the Express backend.
#
# LOCAL DEVELOPMENT — leave this set to the absolute URL below, because Vite
# serves the app from a different port than the API. It must match an entry in
# the backend's CLIENT_ORIGIN list (default http://localhost:5173).
VITE_API_URL=http://localhost:3000

# PRODUCTION — set this to an EMPTY value. The Backend serves the built frontend
# itself, so requests are same-origin and relative paths resolve against whatever
# host the page was loaded from. This removes CORS entirely and keeps the Render
# URL out of the bundle.
#
#   Render build command:
#     VITE_API_URL= npm run build
#
# The fallback in src/api/client.ts only applies when the variable is undefined,
# so an empty string is preserved and axios treats it as a relative base.
