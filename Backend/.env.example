
PORT=3000

MONGO_URI=mongodb://127.0.0.1:27017/kitty_pedia

GEMINI_API_KEY=

MISTRAL_API_KEY=

# --- Optional -------------------------------------------------------------

# Comma-separated list of origins allowed to call the API. Only relevant in
# development, where Vite serves the app from a different port than the API.
# In production the frontend is served by this same process, so requests are
# same-origin and this is ignored.
# CLIENT_ORIGIN=http://localhost:5173

# Base URL the MCP server uses to call back into this API. It runs as a child
# process in the same container, so loopback is correct and no public URL is
# needed. Override only if the MCP server is ever moved to its own service.
# API_BASE_URL=http://127.0.0.1:3000

# Set to "false" to make "/" return the JSON health check instead of the
# frontend. Only useful when running the API without a frontend build.
# SERVE_SPA=false
